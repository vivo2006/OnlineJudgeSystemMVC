@page
@model IndexModel
@{
    ViewData["Title"] = "Submissions";
    ViewData["ActivePage"] = ManageNavPages.Index;
}
@using X.PagedList.Mvc.Core

<table class="table table-bordered mb-4" style="width:100%;">
    <thead>
        <tr>
            <th>Submitted</th>
            <th>Competition</th>
            <th>Problem</th>
            <th>Score</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Submissions)
        {
            <tr>
                <td>@item.Created</td>
                <td>@EnglishContent.CompetitionCode(item.Problem.Competition.YearCompetition.Competition), @item.Problem.Competition.YearCompetition.Year</td>
                <td>@item.Problem.ProblemNotation. @EnglishContent.ProblemName(item.Problem)</td>
                <td>@item.Points</td>
                <td><a class="text-dark text-decoration-none" asp-controller="Submissions" asp-action="Details" asp-route-id=@item.Id>→</a></td>

            </tr>
        }
    </tbody>
</table>

<ul class="pagination d-flex justify-content-center mt-5">
    @for (int i = 1; i <= Model.Submissions.PageCount; i++)
    {
        <li class="page-item @(Model.Submissions.PageNumber == i ? "active" : "")">
            <a class="page-link" asp-area="Identity" asp-page="/Account/Manage/Index" asp-route-id=@i>@i</a>
        </li>
    }
</ul>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
