@page
@model IndexModel
@{
    ViewData["Title"] = "Събмити";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<table class="table table-bordered" style="width:80%;">
    <thead>
        <tr>
            <th>ID</th>
            <th>Състезание</th>
            <th>Задача</th>
            <th>Точки</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Submissions)
        {
            <tr>
                <td><a class="text-dark" asp-controller="Submissions" asp-action="Details" asp-route-id=@item.Id>@item.Id</a></td>
                <td>@item.Problem.Competition.YearCompetition.Competition.Notation, @item.Problem.Competition.YearCompetition.Year</td>
                <td>@item.Problem.ProblemNotation. @item.Problem.Name</td>
                <td>@item.Points</td>

            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
