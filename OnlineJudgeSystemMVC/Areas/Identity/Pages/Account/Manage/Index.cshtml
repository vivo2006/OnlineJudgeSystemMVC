@page
@model IndexModel
@{
    ViewData["Title"] = "Събмити";
    ViewData["ActivePage"] = ManageNavPages.Index;
}
@using X.PagedList.Mvc.Core

<table class="table table-bordered mb-4" style="width:100%;">
    <thead>
        <tr>
            <th>ID</th>
            <th>Състезание</th>
            <th>Задача</th>
            <th>Точки</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Submissions)
        {
            <tr>
                <td><a class="text-dark" asp-controller="Submissions" asp-action="Details" asp-route-id=@item.Id>@item.Id</a></td>
                <td>@item.Problem.Competition.YearCompetition.Competition.Notation, @item.Problem.Competition.YearCompetition.Year</td>
                <td>@item.Problem.ProblemNotation. @item.Problem.Name</td>
                <td>@item.Points</td>

            </tr>
        }
    </tbody>
</table>

<ul class="pagination d-flex justify-content-center mt-5">
    @for (int i = 1; i <= Model.Submissions.PageCount; i++)
    {
        <li class="page-item @(Model.Submissions.PageNumber == i ? "active" : "")">
            <a class="page-link" asp-area="Identity" asp-page="/Account/Manage/Index" asp-route-id=@i>@i</a>
        </li>
    }
</ul>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
