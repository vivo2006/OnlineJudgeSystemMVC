@model Competition

@{
    ViewData["Title"] = "Delete";
}

<h2 class="mb-5 mt-5">Сигурни ли сте, че искате да изтриете това състезание?</h2>
<div class="d-flex flex-column justify-content-center">
    <hr />
    <h5>
        Име: @Model.Name
    </h5>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Изтрий" class="btn btn-danger" /> 
        <a asp-action="AdministratorIndex" class="btn btn-secondary">Назад</a>
    </form>
</div>
