@model Competition;

@{
    ViewData["Title"] = "Create";
}

<h1>Добави състезание</h1>
<hr />
<div class="d-flex justify-content-center">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label">Име</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FirstYear" class="control-label">Начална година</label>
                <input asp-for="FirstYear" class="form-control" />
                <span asp-validation-for="FirstYear" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastYear" class="control-label">Последна година</label>
                <input asp-for="LastYear" class="form-control" />
                <span asp-validation-for="LastYear" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Notation" class="control-label">Нотация</label>
                <input asp-for="Notation" class="form-control" />
                <span asp-validation-for="Notation" class="text-danger"></span>
            </div>
            <div class="d-flex flex-row justify-content-center mt-3">
                <div class="form-group">
                    <input type="submit" value="Създай" class="btn btn-primary" />
                </div>
            </div>
            
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
