@using BusinessLayer
@model IEnumerable<BusinessLayer.Competition>

@{
    ViewData["Title"] = "Index";
}

<link rel="stylesheet" href="~/css/IndexCompetitions.css" asp-append-version=true />
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

<div class="mt-5 mb-5">
    <h1>Състезания</h1>
</div>

<div id="container-table">
    @foreach (var competition in Model)
    {
        <div class="competition-item">
            <button class="btn btn-primary btn-open-modal mt-5" id="box"
                    data-id="@competition.Id"
                    data-name="@competition.Name"
                    data-bs-toggle="modal"
                    data-bs-target="#yearsModal"
                    data-role="@Role.Admin" 
                    data-is-admin="@User.IsInRole(Role.Admin.ToString())">
                @competition.Name
            </button>
        </div>
    }
</div>

<!-- Modal -->
<div class="modal fade" id="yearsModal" tabindex="-1" aria-labelledby="yearsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="yearsModalLabel">Години</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul id="yearsList" class="list-group">
                    <!-- Years will be loaded dynamically -->
                </ul>
            </div>
        </div>
    </div>
</div>

<script src="~/js/FillTable.js?6">
    
</script>



