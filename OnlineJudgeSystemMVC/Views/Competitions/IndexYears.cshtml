@model IEnumerable<BusinessLayer.YearCompetition>

@{
    ViewData["Title"] = "IndexYears";
}

<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<link href="@Url.Content("~/css/IndexYears.css")" rel="stylesheet" type="text/css" />

<div class="container-container">
    <div class="left-section">
        <h1>@Model.First().Competition.Name</h1>

        <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                Изберете година
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                @foreach (var item in Model)
                {
                    <li><a class="dropdown-item" href="#" data-id="@item.Id">@item.Year</a></li>
                }
            </ul>
        </div>
    </div>
    <div class="right-section">
        <table class="table mt-4" id="dataTable">
            <thead>
                <tr>
                    <th>Година</th>
                    <th>Задачи</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<script src="~/js/DropDownTable.js">

</script>