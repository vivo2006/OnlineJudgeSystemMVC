@using BusinessLayer
@using BusinessLayer.Entities
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>


    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnlineJudgeSystemMVC.styles.css" asp-append-version="true" />
</head>
<body class="d-flex">
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-lg navbar-light bg-white border-bottom box-shadow height-inherit">
            <div class="container-fluid height-inherit">
                <img src="~/Logo/logo.png" alt="Logo" class="responsive-img">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Начало</a>
                        </li>
                        @if (User.IsInRole(Role.Admin.ToString()))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Competitions" asp-action="AdministratorIndex">Състезания</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Competitions" asp-action="Index">Състезания</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Leaderboard">Класиране</a>
                        </li>
                        @if (User.IsInRole(Role.Admin.ToString()))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Admin/AdminIndex">Акаунти</a>
                            </li>
                        }
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <div class="d-flex justify-content-center flex-column">
                                    <a href="#" class="nav-link text-dark d-block d-lg-none align-middle text-center" id="profileToggle" data-bs-toggle="collapse" data-bs-target="#profileList" aria-expanded="false" aria-controls="profileList">
                                        Профил
                                    </a>
                                    <div class="collapse justify-content-center" id="profileList">
                                        <a class="nav-link d-block d-lg-none align-middle text-center" asp-area="Identity" asp-page="/Account/Manage/Index" id="profile" style="font-size:100%;color:#ED2A4F;">Събмити</a>
                                        <a class="nav-link d-block d-lg-none align-middle text-center" asp-area="Identity" asp-page="/Account/Manage/ChangePassword" id="change-password" style="font-size:100%;color:#ED2A4F;">Промяна на паролата</a>
                                        <a class="nav-link d-block d-lg-none align-middle text-center" asp-area="Identity" asp-page="/Account/Manage/PersonalData" id="personal-data" style="font-size:100%;color:#ED2A4F;">Данни</a>
                                    </div>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a href="#" id="logout" class="nav-link text-dark d-block d-lg-none align-middle" onclick="event.preventDefault(); document.getElementById('logoutForm').submit();">Изход</a>

                                <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" style="display: none;">
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark d-block d-lg-none" id="login" asp-area="Identity" asp-page="/Account/Login">Вход</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark d-block d-lg-none" id="register" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
                            </li>
                        }
                    </ul>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown">
                            <button class="btn btn-primary dropdown-toggle d-none d-lg-block me-3" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                Профил
                            </button>
                            <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                <a class="dropdown-item d-none d-lg-block" asp-area="Identity" asp-page="/Account/Manage/Index" id="profile">Събмити</a>
                                <a class="dropdown-item d-none d-lg-block" asp-area="Identity" asp-page="/Account/Manage/ChangePassword" id="change-password">Промяна на паролата</a>
                                <a class="dropdown-item d-none d-lg-block" asp-area="Identity" asp-page="/Account/Manage/PersonalData" id="personal-data">Данни</a>
                            </div>
                        </div>
                        <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                            <button id="logout" type="submit" class="btn btn-secondary d-none d-lg-block align-middle">Изход</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-primary d-none d-lg-block" id="login" asp-area="Identity" asp-page="/Account/Login">Вход</a>
                        <a class="btn btn-secondary d-none d-lg-block" id="register" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="blank-space-up"></div>
    <div class="container mt-5 mb-5">
        <main role="main" class="main justify-content-around">
            @RenderBody()
        </main>
    </div>
    <!--<div class="blank-space-down"></div>-->
    <footer class="flex-row justify-content-start">
        <div class="border-top">
            <div class="h-100 align-center d-flex justify-content-center">
                <p>© 2025 CodeXpert. Всички права запазени.</p>
            </div>
        </div>
            
        
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Initialize Bootstrap dropdown
        const dropdownElementList = document.querySelectorAll('.dropdown-toggle');
        const dropdownList = [...dropdownElementList].map(dropdownToggleEl => new bootstrap.Dropdown(dropdownToggleEl));
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
