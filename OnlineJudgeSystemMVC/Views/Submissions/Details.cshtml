@model Submission

@{
    ViewData["Title"] = "Test Results";
    int testNumber = 1;
}

<h1 class="mb-5">Submission results</h1>
<p><strong>Status:</strong> @Model.Status</p>
@if (!string.IsNullOrEmpty(Model.Error)) { <p class="alert alert-info">@Model.Error</p> }
<p>Results are checked once after 10 seconds by default to conserve API quota. Refreshing this page reads saved results only.</p>

<table class="table table-bordered mb-5">
    <thead>
        <tr>
            <th>Test</th>
            <th>Status</th>
            <th>Time (seconds)</th>
            <th>Memory (MB)</th>
            <th>Output</th>

        </tr>
    </thead>
    <tbody>
        @if(Model.TestCaseResults.Count != 0)
        {
            @foreach (var item in Model.TestCaseResults)
            {
                <tr>
                    <td>@testNumber</td>
                    <td>@item.State</td>
                    <td>@item.Time</td>
                    <td>@item.Memory</td>
                    <td>
                        <a class="text-dark text-decoration-none" asp-action="OutputDetails" asp-route-id=@item.Id>→</a>
                    </td>

                </tr>
                testNumber++;
            }
        }
        else
        {
            <tr>
                <td colspan="5">No completed test results are available. See the status above. </td>
            </tr>
        }

    </tbody>
</table>

<h3 class="text-start">Source code:</h3>
<pre class="fs-5 text-start">
@Model.Code
</pre>
