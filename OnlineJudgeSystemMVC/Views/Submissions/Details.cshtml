@model BusinessLayer.Submission

@{
    ViewData["Title"] = "Test Results";
    int testNumber = 1;
}

<h1>Резултати от тестването</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Тест</th>
            <th>Статус</th>
            <th>Време (ms)</th>
            <th>Памет (MB)</th>
            <th>Изход</th>

        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model.TestCaseResults)
        {
            <tr>
                <td>@testNumber</td>
                <td>@item.State</td>
                <td>@item.Time</td>
                <td>@item.Memory</td>
                <td>
                    <a class="text-dark" asp-action="OutputDetails" asp-route-id=@item.Id>→</a>
                </td>

            </tr>
            testNumber++;
        }
    </tbody>
</table>

<a href="/" class="btn btn-primary">Back to Problems</a>