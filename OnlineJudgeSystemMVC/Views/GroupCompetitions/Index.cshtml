@model ICollection<GroupCompetition>
@using BusinessLayer;
@using BusinessLayer.Entities;


@{
    ViewData["Title"] = $"{@ViewBag.Competition} - {@ViewBag.Year}";
}

<h1>@ViewBag.Competition - @ViewBag.Year</h1>

    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Група</th>
                    <th>Задачи</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model)
                {
                    <tr>
                        <td>@group.Group</td>
                        <td>
                            <ul class="list-unstyled mb-0">
                                @foreach (var problem in group.Problems)
                                {
                                    <li>
                                        <div class="d-flex flex-row justify-content-center align-middle m-auto">
                                            <a class="text-decoration-none text-dark align-middle mt-auto mb-2" asp-area="" asp-controller="Problems" asp-action="Details" asp-route-id=@problem.Id asp-route-CompetitionNotation=@ViewBag.CompetitionNotation asp-route-Year=@ViewBag.Year>@problem.Name</a>
                                            @if (User.IsInRole(Role.Admin.ToString()))
                                            {
                                                <a class="nav-link text-dark ms-3" asp-area="" asp-controller="Problems" asp-action="Edit" asp-route-id=@problem.Id asp-route-groupId=@group.Id>✏️</a>
                                                <a class="nav-link text-dark ms-2" asp-area="" asp-controller="Problems" asp-action="Delete" asp-route-id=@problem.Id>🗑️</a>
                                            }
                                        </div>
                                    </li>
                                }
                                <li>
                                    @if (User.IsInRole(Role.Admin.ToString()))
                                    {
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Problems" asp-action="Create" asp-route-id=@group.Id>+</a>
                                    }
                                </li>
                            </ul>
                        </td>
                </tr>
                }
            </tbody>
        </table>
    </div>

