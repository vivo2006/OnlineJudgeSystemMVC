@model ICollection<BusinessLayer.GroupCompetition>
@using BusinessLayer;


@{
    ViewData["Title"] = "IndexFromYearCompetition";
}

<h1>@ViewBag.Competition - @ViewBag.Year</h1>

    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Група</th>
                    <th>Задачи</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model)
                {
                    <tr>
                        <td>@group.Group</td>
                        <td>
                            <ul class="list-unstyled">
                                @foreach (var problem in group.Problems)
                                {
                                    <li>
                                        <a asp-area="" asp-controller="Problems" asp-action="Details" asp-route-id=@problem.Id asp-route-CompetitionNotation=@ViewBag.CompetitionNotation asp-route-Year=@ViewBag.Year>@problem.Name</a>
                                        @if (User.IsInRole(Role.Admin.ToString()))
                                        {
                                            <a class="nav-link text-dark" asp-area="" asp-controller="Problems" asp-action="Edit" asp-route-id=@problem.Id asp-route-groupId=@group.Id>✏️</a>
                                            <a class="nav-link text-dark" asp-area="" asp-controller="Problems" asp-action="Delete" asp-route-id=@problem.Id>🗑️</a>
                                        }
                                    </li>
                                }
                                <li>
                                    @if (User.IsInRole(Role.Admin.ToString()))
                                    {
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Problems" asp-action="Create" asp-route-id=@group.Id>+</a>
                                    }
                                </li>
                            </ul>
                        </td>
                </tr>
                }
            </tbody>
        </table>
    </div>

