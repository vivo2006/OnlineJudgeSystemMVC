@model ICollection<BusinessLayer.GroupCompetition>


@{
    ViewData["Title"] = "IndexFromYearCompetition";
}

<h1>@ViewBag.Competition - @ViewBag.Year</h1>

    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Група</th>
                    <th>Задачи</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model)
                {
                    <tr>
                        <td>@group.Group</td>
                        <td>
                            <ul class="list-unstyled">
                                @foreach (var problem in group.Problems)
                                {
                                    <li><a asp-area="" asp-controller="Problems" asp-action="Details" asp-route-id=@problem.Id>@problem.Name</a></li>
                                }
                            </ul>
                        </td>
                        <td>
                            <a class="nav-link text-dark" asp-area="" asp-controller="Problems" asp-action="Create" asp-route-id=@group.Id>+</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

