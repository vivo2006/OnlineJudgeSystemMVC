@model BusinessLayer.Problem

@{
    ViewData["Title"] = "Create";
}


<h1>Добави задача</h1>

<hr />
<div class="d-flex justify-content-center">
    <div class="col-md-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label">Име</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="GroupId"></label>
                <input type="hidden" id="GroupId" name="GroupId" class="form-control" value="@ViewBag.GroupId" />
            </div>
            <div class="form-group">
                <label for="Competition">Състезание</label>
                <input type="text" id="Competition" name="Competition" class="form-control" value="@ViewBag.Competition - @ViewBag.Year, @ViewBag.Group" readonly />
            </div>
            <div class="form-group">
                <label asp-for="TimeLimit" class="control-label">Лимит за време</label>
                <input asp-for="TimeLimit" class="form-control" />
                <span asp-validation-for="TimeLimit" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MemoryLimit" class="control-label">Лимит за памет</label>
                <input asp-for="MemoryLimit" class="form-control" />
                <span asp-validation-for="MemoryLimit" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProblemNotation" class="control-label">Нотация</label>
                <input asp-for="ProblemNotation" class="form-control" />
                <span asp-validation-for="ProblemNotation" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="pdfFile">Условие на задачата</label>
                <input type="file" class="form-control-file" id="pdfFile" name="pdfFile" accept=".pdf" required />
            </div>
            <div>
                <label for="testCases">Тестове на задачата</label>
                <input type="file" id="testCases" name="testCases" webkitdirectory multiple />
            </div>
            <div class="d-flex flex-row justify-content-center mt-3">
                <div class="form-group">
                    <input type="submit" value="Създай" class="btn btn-primary" />
                </div>
            </div>
    </form>
</div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
