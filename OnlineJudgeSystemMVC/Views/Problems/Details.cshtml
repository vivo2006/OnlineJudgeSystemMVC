@model Problem
@{
    ViewData["Title"] = "Problem";
}
<link rel="stylesheet" href="~/css/ProblemDetails.css" asp-append-version="true" />

<div class="d-flex flex-column">
    <div class="d-flex flex-row justify-content-between">

        <!-- Time and Memory Limit -->
        <div class="d-flex align-items-center mb-4">
            <h1 class="me-4" id="icons">
                @Model.ProblemNotation. 
                <a class="text-decoration-none" asp-area="" asp-controller="Submissions" asp-action="Index" asp-route-problemId=@Model.Id style="color:#ED2A4F">@EnglishContent.ProblemName(Model)</a>
            </h1>
            <div class="me-4" id="icons">
                <span class="fs-5">⏳</span>
                <span>@Model.TimeLimit seconds</span>
            </div>
            <div class="me-2" id="icons">
                <span class="fs-5">💾</span>
                <span>@Model.MemoryLimit MB</span>
            </div>
        </div>    
        <div>
            <a href="@EnglishContent.StatementUrl(Model.URL)" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Open statement</a>
            <button type="submit" form="code-submit" class="btn btn-secondary me-0">Submit</button>
        </div>
        
    </div>

    <select form="code-submit" name="LanguageId" class="form-select mb-4">
        <option value="54">C++</option>
        <option value="62">Java</option>
        <option value="71">Python</option>
        <option value="63">JavaScript</option>
        <option value="51">C#</option>
    </select>
    <!-- Buttons -->
    <div class="mb-4">
        <form id="code-submit" method="post" asp-area="" asp-controller="Submissions" asp-action="Create" asp-route-ProblemId=@Model.Id >
            <input type="hidden" name="ProblemId" value="@Model.Id" />
            <textarea name="Code" class="form-control border-danger mb-1" rows="10" placeholder="Paste your code here..." required></textarea>
        </form>
    </div>
    @if(Model.Id == ViewBag.ChallengeId)
    {
        <hr>
        <p>Earn a 10-point bonus once per UTC day by improving your best accepted runtime or memory usage on the daily challenge.</p>
    }
</div>

