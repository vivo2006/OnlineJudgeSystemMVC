@model Problem

@{
    ViewData["Title"] = "Изтрий";
}

<h2>Сигурни ли сте, че искате да изтриете тази задача?</h2>

<div>
    <hr />
    <h5>
        Име: @Model.Name
    </h5>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Изтрий" class="btn btn-danger" />
    </form>
</div>