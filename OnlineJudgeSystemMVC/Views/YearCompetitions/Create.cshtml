@model YearCompetition

@{
    ViewData["Title"] = "Добави година";
}

<h1>Добави година</h1>
<hr />
<div class="d-flex justify-content-center">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Year" class="control-label">Година</label>
                <input asp-for="Year" class="form-control" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input  type="hidden" id="CompetitionId" name="CompetitionId" class="form-control" value="@ViewBag.CompetitionId" />
            </div>
            <div class="form-group">
                <label for="Competition">Състезание</label>
                <input type="text" id="CompetitionId" name="Competition" class="form-control" value="@ViewBag.Competition" readonly />
            </div>
            <div class="d-flex flex-row justify-content-center mt-3">
                <div class="form-group">
                    <input type="submit" value="Създай" class="btn btn-primary" />
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-secondary">Назад</a>
                </div>
            </div>
            
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
