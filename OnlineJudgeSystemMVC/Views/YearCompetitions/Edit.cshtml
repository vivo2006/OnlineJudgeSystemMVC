@model YearCompetition

@{
    ViewData["Title"] = "Edit";
}

<h1>Редактирай година</h1>

<hr />
<div class="d-flex justify-content-center">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CompetitionId" />

            <div class="form-group">
                <label asp-for="Year" class="control-label">Година</label>
                <input asp-for="Year" class="form-control" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="Competition.Name">Състезание</label>
                <input type="text" id="CompetitionName" name="CompetitionName" class="form-control" value="@ViewBag.CompetitionName" readonly />
            </div>
            <div class="d-flex flex-row justify-content-center mt-3">
                <div class="form-group">
                    <input type="submit" value="Запази" class="btn btn-primary" />
                </div>
                <div>
                    <a asp-area="" asp-controller="Competitions" asp-action="Index" class="btn btn-secondary">Назад</a>
                </div>
            </div>
            
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
