@model YearCompetition

@{
    ViewData["Title"] = "Изтрий";
}

<h2>Сигурни ли сте, че искате да изтриете тази година?</h2>

<div>
    <hr />
    <h5>
        Година: @Model.Year
    </h5>
    <h5>
        Състезание: @Model.Competition.Name
    </h5>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Изтрий" class="btn btn-danger" /> 
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </form>
</div>
